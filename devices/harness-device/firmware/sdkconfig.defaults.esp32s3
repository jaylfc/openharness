# The round dial (ESP32-S3-Touch-AMOLED-1.75C), everything specific to the silicon.
#
# CONFIG_IDF_TARGET moved to sdkconfig.defaults when the Pro left — see the note there. This file is
# kept rather than folded in because IDF's per-target mechanism is what applies it, and a value that
# names a pin count, a PSRAM mode or a CPU clock belongs on that side of the line.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM (ESP32-S3R8 = 8MB octal PSRAM; LVGL object pool lives here) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- WiFi: the optional LAN transport (main/wifi_sta.c) ---------------------------------------------------
# A bare station, brought up only when a network has been saved over the cable. Memory is the constraint,
# not throughput: the link carries small JSON frames and, at most, one voice stream at 32 KB/s.
#
#   * no SoftAP: there is no on-device setup, so no AP, no portal and no beacon buffers
#   * few STATIC RX buffers (each ~1.6 KB of INTERNAL, DMA-capable RAM, the one thing the radio cannot
#     take from PSRAM); the DYNAMIC pools and the TX buffers come from PSRAM first
#     (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP above). RX_BA_WIN must not exceed 2x the static count.
#   * the driver's IRAM copies of hot paths are OFF: with the compositor already filling internal RAM,
#     ~20 KB of shared IRAM/DRAM is worth more than a few microseconds per packet
#   * credentials live in our own NVS namespace (config_store.c), not the driver's, so a factory reset
#     finds every one of them
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Wifi/DHCP/mDNS event handlers run on this task and log; 2304 is thin for that.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

# --- mDNS: one service (_harness-dial._tcp), station only, nothing browsed ---
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MDNS_MAX_SERVICES=2
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_MULTIPLE_INSTANCE=n

# --- HTTP server (captive portal) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# --- WebSocket client ---
CONFIG_WS_TRANSPORT=y

# --- TLS (wss:// + https:// to the prod backend) ---
# Verify the prod cert chain against Mozilla's CA roots via esp_crt_bundle_attach.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Leave CONFIG_MBEDTLS_HAVE_TIME_DATE OFF (default) so the TLS handshake does NOT depend on a synced
# clock — REST pairing runs before SNTP, and cert validity dates are not enforced.
# Allocate mbedTLS buffers (~32KB per TLS conn: two 16KB record buffers) from the 8MB PSRAM instead
# of the ~150KB internal heap. Internal heap fragments after the first few TLS connections, so the
# persistent commander WSS + periodic REST fail ssl_setup with -0x7F00 (ALLOC_FAILED) / sock<0.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- LWIP: one TCP client, plus what DHCP/mDNS/DNS need ---
# The old values (16 sockets, 64 KB send and receive windows) were sized for a backend WebSocket plus HTTP
# plus TLS at once. The LAN link is one connection; 16 KB windows hold a few hundred ms of the 32 KB/s
# voice stream and one 16 KB firmware credit window, and cap what a peer can pin in lwIP buffers.
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
